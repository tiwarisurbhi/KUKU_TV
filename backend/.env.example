# --- Writing model: SiliconFlow ---
# Used in order. A key that runs out of credit (or is invalid) is retired for good and the next one takes over.
SILICONFLOW_API_KEY_1=
SILICONFLOW_API_KEY_2=
SILICONFLOW_API_KEY_3=
SILICONFLOW_API_KEY_4=
SILICONFLOW_API_KEY_5=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
LLM_MODEL=Qwen/Qwen3.8-27B

# --- Narration: Cartesia (same failover) ---
CARTESIA_API_KEY_1=
CARTESIA_API_KEY_2=
CARTESIA_API_KEY_3=
CARTESIA_API_KEY_4=
CARTESIA_API_KEY_5=
TTS_MODEL=sonic-3.6
VOICE_DEFAULT=4459a9a5-69d6-4680-b970-e13dc51845b6
VOICE_GRANDMA=4459a9a5-69d6-4680-b970-e13dc51845b6
VOICE_RADIO=0f14d8cb-f039-41fe-a813-a9b4bee7eed8
VOICE_TRAILER=7e8cb11d-37af-476b-ab8f-25da99b18644
# Cartesia emotion tags: all (every language, experiment) | english (Cartesia docs) | off
TTS_EMOTION_TAGS=all

# --- Offline demo without keys (1 = on) ---
MOCK_LLM=0
MOCK_TTS=0
